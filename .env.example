# =============================================================================
# Phase 0 — environment template (no secrets in git)
# =============================================================================
# Copy to `.env` and fill in values (never commit `.env`). With direnv, `.envrc`
# loads `.env` via `dotenv_if_exists` (see `.envrc`). `uv run bronze-cli` also loads
# this file from the repo root first (override=False) so `task bronze:*` picks up
# the same variables without relying on direnv.
#
# Host tools: `task check-tools` from repo root.

# -----------------------------------------------------------------------------
# AWS (bronze landing — real account)
# -----------------------------------------------------------------------------
AWS_PROFILE=
AWS_REGION=
# Optional; render-iam can derive via `aws sts get-caller-identity`
# AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Shared workshop (recommended in a shared AWS account)
# -----------------------------------------------------------------------------
# One id per participant (letters, numbers, underscore, hyphen). When set, leave
# BRONZE_BUCKET_NAME and BRONZE_S3TABLES_BUCKET_NAME empty (below) for:
#   BRONZE_BUCKET_NAME=<bucket_slug>-balloon-bronze
#   BRONZE_S3TABLES_BUCKET_NAME=<bucket_slug>-balloon-s3tables
#   GLUE_DATABASE=<glue_slug>_balloon_pops   (when GLUE_DATABASE is unset)
# Or set a short suffix for either bucket → <bucket_slug>-<suffix> (sanitized).
# See tools/bronze_preload/bronze_aws.py.
# LAB_USERNAME=

# -----------------------------------------------------------------------------
# Iceberg warehouse (Glue + PyIceberg)
# -----------------------------------------------------------------------------
# Workshop (LAB_USERNAME): leave empty for <bucket_slug>-balloon-bronze, or set a
# short suffix → <bucket_slug>-<suffix>. Solo: set a full globally unique name.
# Warehouse URI is s3://<resolved-bucket>/iceberg/ (glue-setup prints it).
BRONZE_BUCKET_NAME=

# Glue database: defaults to balloon_pops when unset. With LAB_USERNAME, omit this
# variable so the CLI can set <glue_slug>_balloon_pops. Set only to override.
# GLUE_DATABASE=balloon_pops

# Bronze load volume (see `uv run load-bronze-sample --help`):
# - Default path: simulate ``packages/generator`` pops for BRONZE_LOAD_DURATION_MINUTES (default 5)
#   at DELAY or BRONZE_GENERATOR_DELAY seconds per pop, then append one JSON object per row
#   to Glue Iceberg ``balloon_game_events.event`` (aggregates: Snowflake DT + PARSE_JSON).
# - Synthetic fast path: set BRONZE_SAMPLE_ROW_COUNT or pass --row-count N (that many GameEvents).
# BRONZE_LOAD_DURATION_MINUTES=5
# BRONZE_GENERATOR_DELAY=1.0
# NUM_PLAYERS=12
# BRONZE_SAMPLE_ROW_COUNT=2500

# -----------------------------------------------------------------------------
# Amazon S3 Tables (CLI 2.34+)
# -----------------------------------------------------------------------------
# Same pattern as BRONZE_BUCKET_NAME: empty + LAB_USERNAME → <bucket_slug>-balloon-s3tables.
# Solo: set a full globally unique table-bucket name ([a-z0-9-], 3–63 chars).
BRONZE_S3TABLES_BUCKET_NAME=
# Optional testing: 1/true/yes/y/on → append -<epoch_millis> to resolved BRONZE_S3TABLES_BUCKET_NAME
# once at the start of s3tables-setup (not on every CLI run). After s3tables-setup, Snowflake/IAM tools
# read the table-bucket from .aws-config/s3tables-table-bucket-arn.txt and bronze-s3tables-last-bucket-name.txt;
# bronze:cleanup removes those bronze files after successful teardown.
# BRONZE_S3TABLES_BUCKET_ENABLE_SUFFIX=
S3TABLES_NAMESPACE=balloon_pops

# -----------------------------------------------------------------------------
# IAM policy render (lab/aws/bronze-glue-writer-policy.json → .aws-config/)
# -----------------------------------------------------------------------------
# BRONZE_S3_ARN is not configured. render-iam sets it from the resolved
# BRONZE_BUCKET_NAME (arn:aws:s3:::<bucket>) for envsubst.

# -----------------------------------------------------------------------------
# Snowflake CLI / SQL (Phase 2+ — catalog integration, CLD, DTs)
# -----------------------------------------------------------------------------
# Default path: no SIGV4 env vars needed — `task snowflake:create-glue-catalog-read-role` writes
# `.aws-config/snowflake-glue-catalog-iam-role-arn.txt`, and `generate-lab-sql` reads it automatically.
# Integration name + linked DB name also have repo defaults (`task snowflake:print-env-hints`).
#
# Override SIGV4 / signer role only when you use your own IAM role (not the task above):
#   SNOWFLAKE_GLUE_CATALOG_IAM_ROLE_ARN=arn:aws:iam::...:role/your-role
#   # or put that ARN on the first line of .aws-config/snowflake-glue-catalog-iam-role-arn.txt
#   # or: snowflake-lab-sql generate --sigv4-role-arn 'arn:...'
# Optional: custom role *name* for `create-glue-catalog-read-role` only:
# SNOWFLAKE_GLUE_CATALOG_IAM_ROLE_NAME=my_custom_role_name
#
# Optional overrides (defaults match lab docs / tasks if unset):
# SNOWFLAKE_CATALOG_INTEGRATION_NAME=glue_rest_catalog_int
# SNOWFLAKE_LINKED_DATABASE_NAME=balloon_game_events
#
# Glue Iceberg REST — default generator matches Snowflake Step 2: CATALOG_NAME = AWS account id,
# CATALOG_NAMESPACE = GLUE_DATABASE (from glue-database.json). Same shape if you set:
# SNOWFLAKE_GLUE_REST_USE_DATA_CATALOG=1
#
# Amazon S3 Tables composite CATALOG_NAME (opt-in): SNOWFLAKE_GLUE_REST_USE_S3TABLES_CATALOG=1
# or `snowflake-lab-sql generate --glue-s3tables-catalog`, plus table-bucket name from s3tables-setup:
# BRONZE_S3TABLES_BUCKET_NAME=your-table-bucket-name
# S3TABLES_NAMESPACE=balloon_pops
# Optional full CATALOG_NAME override (replaces computed value):
# SNOWFLAKE_GLUE_REST_CATALOG_NAME=123456789012:S3tablescatalog/your-table-bucket-name
#
# Optional — trial / multi-connection (see Snowflake CLI: Managing Snowflake connections):
# SNOWFLAKE_DEFAULT_CONNECTION_NAME=myconnection
# SNOWFLAKE_ROLE=ACCOUNTADMIN
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
#
# Silver external volume (task dt:extvol-*). Resolver: tools/snowflake_lab/extvol_resolve.py
# - Workshop: omit SILVER_EXTVOLUME_BUCKET_SLUG and set LAB_USERNAME → --bucket defaults to
#   balloon-silver; tasks pass --prefix <24-char slug> (same as <bucket_slug> in
#   BRONZE_BUCKET_NAME=<slug>-balloon-bronze) so the S3 bucket mirrors bronze naming.
# - Solo: set SILVER_EXTVOLUME_BUCKET_SLUG to a short unique fragment (passed to sfutils --bucket);
#   tasks omit --prefix (sfutils default = OS username) unless you set global flags yourself.
# Optional override when LAB_USERNAME drives the default: SILVER_EXTVOLUME_PREFIX=other-slug
# Retries (IAM / trust propagation): defaults are fine; set max to 1 to disable.
# SILVER_EXTVOL_CREATE_MAX_ATTEMPTS=3
# SILVER_EXTVOL_CREATE_RETRY_SECS=45
# SILVER_EXTVOL_VERIFY_MAX_ATTEMPTS=5
# SILVER_EXTVOL_VERIFY_RETRY_SECS=20
# SILVER_EXTVOLUME_BUCKET_SLUG=myname-balloon-silver
# SILVER_EXTVOLUME_PREFIX=
#
# Dynamic Iceberg Tables (after CLD + external volume for Iceberg files; task dt:generate-sql):
# SNOWFLAKE_ICEBERG_EXTERNAL_VOLUME=my_ext_vol
# SNOWFLAKE_SILVER_DATABASE=balloon_silver
# SNOWFLAKE_SILVER_SCHEMA=silver
# SNOWFLAKE_DT_PATH_PREFIX=balloon_lab
#
# Trust render without `snow` (CI): set both, then `task snowflake:render-glue-catalog-trust`
# (Snowflake may expose either GLUE_AWS_* or API_AWS_* from DESC CATALOG INTEGRATION — same trust use.)
# GLUE_AWS_IAM_USER_ARN=arn:aws:iam::...
# GLUE_AWS_EXTERNAL_ID=...
# API_AWS_IAM_USER_ARN=arn:aws:iam::...
# API_AWS_EXTERNAL_ID=...

# -----------------------------------------------------------------------------
# Optional — automation / PAT
# -----------------------------------------------------------------------------
# SNOWFLAKE_PAT_PATH=

# -----------------------------------------------------------------------------
# Legacy / local stack (ignore for Snowflake-only bronze path)
# -----------------------------------------------------------------------------
# BONUS_PROBABILITY=0.15
