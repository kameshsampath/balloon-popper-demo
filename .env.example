# =============================================================================
# Phase 0 — environment template (no secrets in git)
# =============================================================================
# Copy to a local file and load before tasks:
#   cp .env.example .env
# With direnv: values here are picked up via `dotenv_if_exists` in `.envrc` (see that file)
# (or put overrides in `.envrc.local`). Do not commit `.env`.
#
# Improve this file as the lab grows (Snowflake SQL vars, PAT paths, DuckDB IRC, …).

# -----------------------------------------------------------------------------
# AWS (bronze landing — real account)
# -----------------------------------------------------------------------------
AWS_PROFILE=
AWS_REGION=
# Optional; render-iam can derive via `aws sts get-caller-identity`
# AWS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Shared workshop (optional — avoids Glue / S3 name collisions)
# -----------------------------------------------------------------------------
# Participant id (letters, numbers, underscore, hyphen). When set, the bronze
# CLI defaults GLUE_DATABASE and BRONZE_S3TABLES_BUCKET_NAME if those vars are unset:
# <glue_slug>_balloon_pops and <bucket_slug>-balloon-s3tables (see
# ``tools/bronze-preload/bronze_aws.py`` / ``bronze_cli.py``).
# Exporting GLUE_DATABASE or BRONZE_S3TABLES_BUCKET_NAME yourself always wins.
# LAB_USERNAME=

# -----------------------------------------------------------------------------
# Iceberg warehouse (Glue + PyIceberg load path)
# -----------------------------------------------------------------------------
# S3 URI for Iceberg files (bucket and prefix must exist; create the bucket outside this repo)
BRONZE_WAREHOUSE=s3://YOUR_BUCKET/iceberg/
# Default Glue DB name. Unset (or remove from `.env`) when using LAB_USERNAME if you
# want the derived name <glue_slug>_balloon_pops instead of balloon_pops.
GLUE_DATABASE=balloon_pops

# -----------------------------------------------------------------------------
# Amazon S3 Tables (CLI 2.34+; globally unique name)
# -----------------------------------------------------------------------------
# Unset when using LAB_USERNAME if you want the derived table-bucket name.
BRONZE_S3TABLES_BUCKET_NAME=
S3TABLES_NAMESPACE=balloon_pops

# -----------------------------------------------------------------------------
# IAM policy render (lab/aws/bronze-glue-writer-policy.json → .aws-config/)
# -----------------------------------------------------------------------------
# Warehouse *bucket* ARN for IAM render (no trailing slash or /*). Must match the
# Iceberg warehouse bucket used in BRONZE_WAREHOUSE.
BRONZE_S3_ARN=arn:aws:s3:::YOUR_BUCKET

# -----------------------------------------------------------------------------
# Snowflake CLI / SQL (fill when you add snowflake/lab phases)
# -----------------------------------------------------------------------------
# SNOWFLAKE_CONNECTION_NAME=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=

# -----------------------------------------------------------------------------
# Optional — automation / PAT (add when wiring sfutils-pat)
# -----------------------------------------------------------------------------
# SNOWFLAKE_PAT_PATH=

# -----------------------------------------------------------------------------
# Legacy / local stack (ignore for Snowflake-only bronze path)
# -----------------------------------------------------------------------------
# BONUS_PROBABILITY=0.15
