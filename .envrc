export PROJECT_HOME="$PWD"
export KUBECONFIG="$PWD/.kube/config"
export K3D_CLUSTER_NAME=balloon-popper-demo
export K3S_VERSION=v1.32.1-k3s1
export FEATURES_DIR="$PWD/k8s"
unset AWS_PROFILE

PATH_add "$PWD/bin"

dotenv_if_exists
# dotenv does not expand ${…} in values; support LAB_USERNAME=${USERNAME} from .env
export USERNAME="${USERNAME:-$USER}"
if [[ "${LAB_USERNAME:-}" == '${USERNAME}' ]]; then
  export LAB_USERNAME="$USERNAME"
fi
source_env_if_exists .envrc.local
