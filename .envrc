export PROJECT_HOME="$PWD"

PATH_add "$PWD/bin"

dotenv_if_exists
# dotenv does not expand ${…} in values; support LAB_USERNAME=${USERNAME} from .env
export USERNAME="${USERNAME:-$USER}"
if [[ "${LAB_USERNAME:-}" == '${USERNAME}' ]]; then
  export LAB_USERNAME="$USERNAME"
fi

# uv project venv (after `uv sync`); keeps `python` / tools on PATH without a global `use_uv`
if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi
watch_file uv.lock pyproject.toml

source_env_if_exists .envrc.local
