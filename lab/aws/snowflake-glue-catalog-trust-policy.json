{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SnowflakeGlueCatalogIntegration",
      "Effect": "Allow",
      "Principal": {
        "AWS": "${GLUE_AWS_IAM_USER_ARN}"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "${GLUE_AWS_EXTERNAL_ID}"
        }
      }
    }
  ]
}
