{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadForIceberg",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::${BRONZE_BUCKET_NAME}",
        "arn:aws:s3:::${BRONZE_BUCKET_NAME}/*"
      ]
    }
  ]
}
